# Скопируйте в .env и заполните. .env НЕ коммитить (см. .gitignore).

# LLM-провайдер (OpenAI vision). Без ключа приложение работает в ручном режиме.
OPENAI_API_KEY=
# Vision-модель для распознавания упаковки (текстовый gpt-4o-mini не видит фото).
ECOMED_VISION_MODEL=gpt-4o
# Текстовая модель для генерации пояснений к отчёту.
ECOMED_TEXT_MODEL=gpt-4o-mini

# Путь к файлу SQLite (по умолчанию рядом с проектом).
ECOMED_DB_PATH=ecomed.db

# Город по умолчанию для демо-семьи.
ECOMED_DEFAULT_CITY=Алматы

# Провайдер цен в аптеках: demo (локальный CSV) или api (партнёрский сервис).
ECOMED_PRICES_PROVIDER=demo
# Заполняются при подключении партнёрского API аптечной сети:
ECOMED_PRICES_API_URL=
ECOMED_PRICES_API_KEY=
